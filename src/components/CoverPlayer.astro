---
import type { Session } from '../data/types';
import { youtubeUrl } from '../data/sessions';
const { session, playerId, seekFromUrl = false } = Astro.props as {
  session: Session; playerId?: string; seekFromUrl?: boolean;
};
---
<div class="video cover-player" data-video={session.video} data-title={session.title} data-player-id={playerId} data-seek={seekFromUrl ? 'true' : undefined}>
  <a class="cover-poster" href={youtubeUrl(session.video)} target="_blank" rel="noopener noreferrer" aria-label={`Play ${session.title}`}>
    <img src={session.cover} alt="" width="1672" height="941" loading="lazy" />
    <span>[play]</span>
  </a>
</div>
<style>
  .cover-poster { display: block; position: absolute; inset: 0; }
  .cover-poster img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .cover-poster span { position: absolute; bottom: .75rem; right: .75rem; padding: .3rem .6rem; background: #000; color: var(--accent); border: 1px solid var(--accent); font-family: var(--mono); }
  .cover-poster:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.cover-player').forEach((container) => {
    const link = container.querySelector<HTMLAnchorElement>('a');
    const video = container.dataset.video;
    if (!link || !video) return;
    const play = (start = 0) => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${video}?autoplay=1${start > 0 ? `&start=${start}` : ''}`;
      frame.title = container.dataset.title ?? 'Session video';
      frame.dataset.video = video;
      if (container.dataset.playerId) frame.id = container.dataset.playerId;
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.allowFullscreen = true;
      container.replaceChildren(frame);
      frame.focus();
    };
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      play();
    });
    if (container.dataset.seek === 'true') {
      const raw = new URLSearchParams(location.search).get('t');
      const start = Number.parseInt(raw ?? '', 10);
      if (raw !== null && Number.isFinite(start) && start >= 0) {
        play(start);
        const youtube = document.querySelector<HTMLAnchorElement>('#session-youtube');
        if (youtube) youtube.href = `https://www.youtube.com/watch?v=${video}&t=${start}s`;
      }
    }
  });
</script>
